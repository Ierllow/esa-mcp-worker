{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "esa-mcp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "kv_namespaces": [
    {
      "binding": "MCP_CONFIG",
      "id": "replace-with-your-kv-namespace-id"
    }
  ],
  "d1_databases": [
    {
      "binding": "OAUTH_CODE_DB",
      "database_name": "esa-mcp-worker-oauth-codes",
      "database_id": "replace-with-your-d1-database-id",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
