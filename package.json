{
  "name": "esa-mcp-worker",
  "version": "0.1.0",
  "private": true,
  "description": "A vendor-neutral Remote MCP server for esa on Cloudflare Workers.",
  "license": "MIT",
  "author": "Ierllow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ierllow/esa-mcp-worker.git"
  },
  "bugs": {
    "url": "https://github.com/Ierllow/esa-mcp-worker/issues"
  },
  "homepage": "https://github.com/Ierllow/esa-mcp-worker#readme",
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:preview": "bash scripts/cloudflare-version.sh",
    "e2e": "bash scripts/e2e-public.sh",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "conventions": "node scripts/check-conventions.mjs",
    "verify": "pnpm conventions && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.21.0",
    "yaml": "^2.8.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2",
    "wrangler": "^4.126.0"
  }
}
